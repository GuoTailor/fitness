<view class="page">
  <view class="head card" wx:if="{{sku}}">
    <view class="title">{{actTitle ? '限时拼团 · ' + actTitle : title}}</view>
    <view class="price-row">
      <text class="gp">拼团价 ¥{{sku.groupPrice / 100}}</text>
      <text class="op">单买 ¥{{sku.price / 100}}</text>
      <text class="cap">{{sku.groupCapacity}}人成团 · {{sku.sessions}}课时</text>
    </view>
    <button class="open-btn" size="mini" loading="{{opening}}" bindtap="onOpen">发起新团</button>
  </view>

  <view class="sec-title">进行中的团</view>
  <view class="gcard card" wx:for="{{groups}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
    <view class="g-main">
      <view class="g-leader">{{item.leaderName}} 的团</view>
      <view class="g-progress">{{item.paidCount}}/{{item.capacity}} 人</view>
    </view>
    <view class="g-side">
      <view class="g-price">¥{{item.priceYuan}}</view>
      <view class="g-end">{{item.endText}} 截止</view>
    </view>
  </view>
  <view class="empty" wx:if="{{!groups.length}}">还没有人开团，来做第一个吧</view>
</view>
