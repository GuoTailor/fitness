<view class="page">
  <view class="coach-bar">
    <text>预约教练：{{coachName}}</text>
  </view>

  <scroll-view scroll-x class="days">
    <view wx:for="{{days}}" wx:key="date"
      class="day {{activeDate === item.date ? 'day-active' : ''}}"
      bindtap="onDate" data-date="{{item.date}}">
      <view class="day-label">{{item.label}}</view>
      <view class="day-sub">{{item.sub}}</view>
    </view>
  </scroll-view>

  <view class="card">
    <view class="section-title">选择时间（每节课 60 分钟）</view>
    <view class="slots">
      <view wx:for="{{slots}}" wx:key="startMinute"
        class="slot {{selectedSlot === index ? 'slot-active' : ''}}"
        bindtap="onSlot" data-index="{{index}}">{{item.label}}</view>
    </view>
    <view class="empty-inline" wx:if="{{!slots.length}}">当天暂无可约时段</view>
  </view>

  <view class="card">
    <view class="section-title">选择课包</view>
    <view wx:for="{{mps}}" wx:key="id"
      class="mp {{selectedMp === index ? 'mp-active' : ''}}"
      bindtap="onMp" data-index="{{index}}">
      <view class="mp-title">{{item.packageTitle}}</view>
      <view class="mp-sub">剩余 {{item.totalSessions - item.usedSessions}} 节</view>
    </view>
    <view class="empty-inline" wx:if="{{!mps.length}}">暂无可用课包</view>
  </view>

  <view class="footer-bar-space"></view>
  <view class="footer-bar">
    <button class="submit-btn" disabled="{{submitting}}" bindtap="onSubmit">
      {{submitting ? '提交中…' : '提交预约（扣 1 课时）'}}
    </button>
  </view>
</view>
