.page { padding-bottom: 40rpx; }
.head { display: flex; background: #fff; padding: 32rpx 24rpx; align-items: center; }
.avatar { width: 132rpx; height: 132rpx; border-radius: 50%; background: #f0f0f0; }
.head-info { margin-left: 24rpx; }
.name { font-size: 36rpx; font-weight: 600; }
.cert { font-size: 20rpx; color: #4a90ff; background: #eef4ff; padding: 4rpx 12rpx; border-radius: 6rpx; margin-left: 12rpx; }
.sub { font-size: 24rpx; color: #999; margin-top: 10rpx; }
.rating { font-size: 22rpx; color: #ffb400; margin-top: 8rpx; }
.video { width: 100%; height: 380rpx; background: #000; }
.card { background: #fff; border-radius: 16rpx; margin: 20rpx 24rpx; padding: 28rpx 24rpx; }
.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.rich { font-size: 26rpx; color: #555; line-height: 1.7; white-space: pre-wrap; }
.schedule { font-size: 24rpx; color: #555; line-height: 1.8; }
.hint { font-size: 22rpx; color: #bbb; margin-top: 12rpx; }
.pkg { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f6f6f6; }
.pkg-title { font-size: 28rpx; }
.pkg-sub { font-size: 22rpx; color: #999; margin-top: 6rpx; }
.pkg-right { text-align: right; }
.pkg-price { color: #e64340; font-size: 28rpx; font-weight: 600; }
.pkg-go { font-size: 22rpx; color: #00b578; margin-top: 6rpx; }
.empty-inline { color: #bbb; font-size: 24rpx; text-align: center; padding: 24rpx 0; }
.footer-bar-space { height: 140rpx; }
.footer-bar { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.04); }
.book-btn { background: linear-gradient(135deg, #4a90ff, #2f6fd8); color: #fff; border-radius: 44rpx; font-size: 30rpx; }
