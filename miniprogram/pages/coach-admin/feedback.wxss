.page { padding: 24rpx; }
.tip { font-size: 22rpx; color: #999; margin-bottom: 20rpx; }
.editor { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; }
.ta { width: 100%; min-height: 200rpx; font-size: 28rpx; }
.ed-btns { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 16rpx; }
.primary { background: #07c160; color: #fff; }
.item { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.item-head { display: flex; justify-content: space-between; margin-bottom: 10rpx; }
.name { font-size: 28rpx; font-weight: 600; }
.meta { font-size: 22rpx; color: #999; }
.fb { font-size: 26rpx; color: #444; line-height: 1.6; }
.fb.none { color: #bbb; }
.op { margin-top: 12rpx; color: #576b95; font-size: 24rpx; }
.empty { text-align: center; color: #bbb; padding: 80rpx 0; font-size: 26rpx; }
