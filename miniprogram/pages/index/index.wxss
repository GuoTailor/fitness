.page {
  padding-bottom: 40rpx;
}

.banner {
  height: 320rpx;
  border-radius: 20rpx;
  overflow: hidden;
  margin: 24rpx 24rpx 0;
}

.banner-img {
  width: 100%;
  height: 100%;
}

.entries {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  margin: 24rpx;
  padding: 28rpx 0;
}

.entry {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: #444;
}

.entry-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
}

.icon-pkg { background: linear-gradient(135deg, #00b578, #009a66); }
.icon-coach { background: linear-gradient(135deg, #4a90ff, #2f6fd8); }
.icon-me { background: linear-gradient(135deg, #ffb400, #e09a00); }
.icon-train { background: linear-gradient(135deg, #7a5cff, #5c3fd8); }

.section {
  margin: 0 24rpx 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.pkg-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.pkg-card {
  width: calc(50% - 10rpx);
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  padding-bottom: 16rpx;
}

.pkg-cover {
  width: 100%;
  height: 200rpx;
  background: #f0f0f0;
}

.pkg-name {
  font-size: 27rpx;
  padding: 12rpx 16rpx 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pkg-meta {
  display: flex;
  justify-content: space-between;
  padding: 4rpx 16rpx;
  align-items: baseline;
}

.pkg-price {
  color: #e64340;
  font-weight: 600;
}

.pkg-sold {
  font-size: 22rpx;
  color: #999;
}

.coach-scroll {
  white-space: nowrap;
}

.coach-card {
  display: inline-block;
  width: 200rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-right: 20rpx;
  text-align: center;
}

.coach-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.coach-name {
  font-size: 28rpx;
  margin-top: 12rpx;
}

.coach-sub {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card.dev {
  margin: 0 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  border: 2rpx dashed #d9e5df;
}

.dev-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.dev-input {
  background: #f6f7f9;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 26rpx;
}

.btn-ghost {
  margin-top: 16rpx;
  background: #f2f8f5;
  color: #00b578;
  border-radius: 44rpx;
  font-size: 26rpx;
}
