.page { padding-bottom: 40rpx; }

.video { width: 100%; height: 420rpx; background: #000; }

.cover { background: #f0f0f0; }

.card { background: #fff; border-radius: 16rpx; margin: 20rpx 24rpx; padding: 28rpx 24rpx; }

.title { font-size: 36rpx; font-weight: 600; }

.meta { display: flex; flex-wrap: wrap; gap: 12rpx; align-items: center; margin-top: 16rpx; }

.tag { font-size: 22rpx; color: #00b578; background: #e8f6f0; padding: 4rpx 16rpx; border-radius: 8rpx; }

.difficulty { font-size: 22rpx; color: #999; }

.rating { font-size: 22rpx; color: #ffb400; }

.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }

.sku-list { display: flex; flex-wrap: wrap; gap: 16rpx; }

.sku { border: 2rpx solid #eee; border-radius: 12rpx; padding: 16rpx 24rpx; min-width: 200rpx; }

.sku-active { border-color: #00b578; background: #f0faf6; }

.sku-name { font-size: 28rpx; font-weight: 500; }

.sku-sub { font-size: 22rpx; color: #999; margin: 8rpx 0; }

.sku-price { color: #e64340; font-weight: 600; }

.rich { font-size: 26rpx; color: #555; line-height: 1.7; white-space: pre-wrap; }

.coach-row { display: flex; align-items: center; padding: 16rpx 0; }

.coach-avatar { width: 88rpx; height: 88rpx; border-radius: 50%; background: #f0f0f0; }

.coach-info { margin-left: 20rpx; }

.coach-name { font-size: 28rpx; font-weight: 500; }

.cert { font-size: 20rpx; color: #4a90ff; background: #eef4ff; padding: 2rpx 10rpx; border-radius: 6rpx; margin-left: 8rpx; }

.coach-sub { font-size: 22rpx; color: #999; margin-top: 6rpx; }

.tabs { display: flex; gap: 32rpx; border-bottom: 1rpx solid #f0f0f0; margin-bottom: 16rpx; }

.tab { font-size: 28rpx; color: #666; padding-bottom: 12rpx; }

.tab-active { color: #00b578; font-weight: 600; border-bottom: 4rpx solid #00b578; }

.review { padding: 16rpx 0; border-bottom: 1rpx solid #f6f6f6; }

.review-head { display: flex; justify-content: space-between; }

.review-stars { color: #ffb400; font-size: 24rpx; }

.review-time { font-size: 22rpx; color: #bbb; }

.review-content { font-size: 26rpx; margin-top: 8rpx; line-height: 1.6; }

.review-reply { margin-top: 12rpx; background: #f8f9fa; border-radius: 8rpx; padding: 12rpx 16rpx; font-size: 24rpx; color: #666; }

.empty-inline { color: #bbb; font-size: 24rpx; text-align: center; padding: 24rpx 0; }

.footer-bar-space { height: 140rpx; }

.footer-bar { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.04); display: flex; align-items: center; gap: 20rpx; }

.pay-amount { flex: 1; display: flex; align-items: baseline; gap: 8rpx; }

.pa-label { font-size: 22rpx; color: #999; }

.pa-num { font-size: 40rpx; font-weight: 700; color: #e64340; }

.buy-btn { background: linear-gradient(135deg, #00b578, #009a66); color: #fff; border-radius: 44rpx; font-size: 30rpx; flex: 1; }

.buy-btn.disabled { background: #c4c9cd; }

/* 新人价与优惠券 */
.np { color: #e64340; font-weight: 700; margin-right: 8rpx; }

.strike { color: #bbb; text-decoration: line-through; font-size: 24rpx; }

.np-tag { font-size: 20rpx; color: #fff; background: linear-gradient(135deg, #ff7a45, #e64340); border-radius: 6rpx; padding: 2rpx 10rpx; margin-left: 8rpx; }

.np-tag.promo-tag { background: linear-gradient(135deg, #ffb800, #ff6600); }

.promo-count {
  margin-top: 16rpx; background: #fff7f0; color: #ff6600;
  border-radius: 10rpx; padding: 10rpx 20rpx; font-size: 24rpx; font-weight: 500;
}

.coupon-bar { display: flex; align-items: center; margin-top: 24rpx; padding: 20rpx 0 4rpx; border-top: 1rpx solid #f5f5f5; }

.c-label { font-size: 26rpx; color: #666; width: 120rpx; }

.c-value { flex: 1; font-size: 24rpx; color: #e64340; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.c-go { font-size: 22rpx; color: #4a90ff; margin-right: 16rpx; }

.c-arrow { color: #ccc; }

.np-tip { margin-top: 16rpx; font-size: 22rpx; color: #ff7a45; background: #fff5f0; border-radius: 8rpx; padding: 12rpx 16rpx; }

/* 课程问答 */
.qa-ask-bar { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.qa-ask-tip { font-size: 24rpx; color: #999; }
.qa-ask-btn { font-size: 26rpx; color: #00B578; }
.qa-form { background: #f8f9fa; border-radius: 12rpx; padding: 16rpx; margin: 16rpx 0; }
.qa-ta { width: 100%; min-height: 120rpx; font-size: 26rpx; }
.qa-form-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 12rpx; }
.qa-anon { display: flex; align-items: center; gap: 8rpx; font-size: 24rpx; color: #666; }
.qa-submit { background: #00B578; color: #fff; }
.qa-item { padding: 20rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.qa-item:last-child { border-bottom: none; }
.qa-q, .qa-a { display: flex; gap: 12rpx; }
.qa-a { margin-top: 16rpx; margin-left: 12rpx; }
.qa-badge { flex-shrink: 0; width: 44rpx; height: 44rpx; border-radius: 8rpx; text-align: center; line-height: 44rpx; font-size: 22rpx; }
.qa-badge.q { background: #e8f4ff; color: #1677ff; }
.qa-badge.a { background: #f0f9eb; color: #67c23a; }
.qa-badge.a.coach { background: #00B578; color: #fff; }
.qa-q-body, .qa-a-body { flex: 1; }
.qa-q-content { font-size: 28rpx; font-weight: 500; }
.qa-a-content { font-size: 26rpx; color: #444; line-height: 1.6; margin-top: 4rpx; }
.qa-meta { font-size: 20rpx; color: #bbb; margin-top: 6rpx; }
.qa-pin { flex-shrink: 0; font-size: 20rpx; color: #ff6600; border: 1rpx solid #ff6600; border-radius: 6rpx; padding: 0 8rpx; height: 36rpx; line-height: 36rpx; }
.qa-none { margin-top: 12rpx; font-size: 22rpx; color: #bbb; }

/* 拼团入口 */
.gb-bar { display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; padding: 18rpx 20rpx; background: #fff5f4; border-radius: 12rpx; }
.gb-price { color: #e64340; font-weight: 700; font-size: 30rpx; margin-right: 14rpx; }
.gb-tip { font-size: 20rpx; color: #b98a86; }
.gb-btn { background: #e64340; color: #fff; }
.gb-btn::after { border: none; }
