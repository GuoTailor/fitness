.page { padding: 24rpx; }
.item { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.row1 { display: flex; justify-content: space-between; }
.time { font-size: 30rpx; font-weight: 600; }
