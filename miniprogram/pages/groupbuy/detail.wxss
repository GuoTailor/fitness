.page { padding: 24rpx; }
.head { padding: 32rpx 28rpx; }
.title { font-size: 32rpx; font-weight: 600; }
.st { display: inline-block; font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 999rpx; margin-top: 12rpx; background: #e6f7ef; color: #00B578; }
.st-3 { background: #fdecea; color: #e64340; }
.price-row { display: flex; align-items: baseline; gap: 16rpx; margin: 20rpx 0 8rpx; }
.gp { color: #e64340; font-size: 40rpx; font-weight: 700; }
.cap { color: #666; font-size: 24rpx; }
.progress { display: flex; align-items: center; gap: 16rpx; margin: 20rpx 0; }
.bar { flex: 1; height: 14rpx; background: #f0f1f3; border-radius: 999rpx; overflow: hidden; }
.fill { height: 100%; background: linear-gradient(90deg, #e64340, #ff7a6e); border-radius: 999rpx; }
.num { font-size: 24rpx; color: #666; }
.end { font-size: 22rpx; color: #999; margin-bottom: 24rpx; }
.btn { color: #fff; font-size: 28rpx; }
.btn::after { border: none; }
.btn.join { background: #e64340; }
.btn.warn { background: #ff976a; }
.btn.ok, .btn.share { background: #00B578; }
.tip { font-size: 22rpx; color: #bbb; text-align: center; margin-top: 16rpx; }
