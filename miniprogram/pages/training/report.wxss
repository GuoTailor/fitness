.page { padding: 24rpx; }
.week-nav { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.nav-btn { background: #f5f6f8; border-radius: 28rpx; padding: 10rpx 28rpx; font-size: 26rpx; color: #555; }
.week-text { font-size: 26rpx; color: #888; }
.stat-grid { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.stat { flex: 1; background: #fff; border-radius: 16rpx; padding: 24rpx 12rpx; text-align: center; }
.stat .v { font-size: 40rpx; font-weight: 700; color: #1a1a1a; }
.stat .l { font-size: 20rpx; color: #999; margin-top: 6rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; }
.sec-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.src-row { display: flex; gap: 24rpx; font-size: 28rpx; color: #555; }
.coach-row { display: flex; justify-content: space-between; padding: 14rpx 0; border-bottom: 1rpx solid #f5f5f5; font-size: 26rpx; }
.coach-row:last-child { border-bottom: none; }
.c-name { font-weight: 500; }
.c-num { color: #888; }
.w-line { display: flex; gap: 20rpx; font-size: 28rpx; color: #07c160; font-weight: 600; }
.tip { text-align: center; font-size: 22rpx; color: #bbb; padding: 8rpx 0 24rpx; }
.txn-empty { font-size: 24rpx; color: #bbb; }
