.card { background: #fff; border-radius: 16rpx; margin: 20rpx 24rpx; padding: 28rpx 24rpx; }

.head { display: flex; justify-content: space-between; margin-bottom: 12rpx; }

.type { font-size: 24rpx; color: #00b578; background: #e8f6f0; padding: 4rpx 16rpx; border-radius: 8rpx; }

.status { font-size: 22rpx; color: #999; }

.st-pending { color: #ff9c00; }

.st-approved { color: #00b578; }

.st-hidden { color: #bbb; }

.star { font-size: 28rpx; color: #ddd; }

.star.on { color: #ffb400; }

.content { font-size: 26rpx; color: #333; margin-top: 12rpx; line-height: 1.6; }

.reply { font-size: 24rpx; color: #555; background: #f8f8f8; border-radius: 10rpx; padding: 14rpx; margin-top: 12rpx; }

.time { font-size: 22rpx; color: #bbb; margin-top: 12rpx; }

.empty { text-align: center; color: #999; font-size: 26rpx; padding: 120rpx 0; }

.go { color: #00b578; margin-top: 16rpx; font-size: 26rpx; }
