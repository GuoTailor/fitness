<view class="page">
  <view class="tip">课包详情页的学员提问：回复带认证标识优先展示，优质问答可置顶沉淀为常见问题</view>

  <view wx:if="{{editing}}" class="editor">
    <textarea class="ta" value="{{content}}" maxlength="1000" placeholder="回复提问（1000 字内）" bindinput="onInput" />
    <view class="ed-btns">
      <button size="mini" bindtap="onCancel">取消</button>
      <button size="mini" class="primary" bindtap="onSave">发送回复</button>
    </view>
  </view>

  <view class="q" wx:for="{{list}}" wx:key="id">
    <view class="q-head">
      <text class="asker">{{item.asker}}</text>
      <view class="q-ops">
        <text class="pin {{item.pinned ? 'pinned' : ''}}" bindtap="onPin" data-id="{{item.id}}">{{item.pinned ? '已置顶' : '置顶'}}</text>
        <text class="reply" bindtap="onReply" data-id="{{item.id}}">回复 ›</text>
      </view>
    </view>
    <view class="q-content">{{item.content}}</view>
    <view class="q-meta">{{item.timeText}}</view>
    <view class="a" wx:for="{{item.answers}}" wx:for-item="a" wx:key="id">
      <text class="a-badge {{a.isCoach ? 'coach' : ''}}">{{a.isCoach ? '教练' : '学员'}}</text>
      <view class="a-body">
        <view class="a-content">{{a.content}}</view>
        <view class="a-meta">{{a.authorName || '学员'}} · {{a.timeText}}</view>
      </view>
    </view>
  </view>
  <view class="empty" wx:if="{{!list.length}}">暂无学员提问</view>
</view>
