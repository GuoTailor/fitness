<view class="page">
  <view class="card" wx:for="{{items}}" wx:key="index">
    <view class="head">
      <view class="nick">{{item.nickname}}</view>
      <view class="status st-{{item.review.status}}">{{item.statusText}}</view>
    </view>
    <view class="row">
      <view class="stars">
        <text wx:for="{{item.starsArr}}" wx:for-item="s" wx:key="*this" class="star {{s ? 'on' : ''}}">★</text>
      </view>
      <view class="time">{{item.timeText}}</view>
    </view>
    <view class="content" wx:if="{{item.review.content}}">{{item.review.content}}</view>
    <view class="reply" wx:if="{{item.review.coachReply}}">
      <view class="reply-tag">我的回复</view>
      <view>{{item.review.coachReply}}</view>
    </view>
    <button size="mini" class="reply-btn" wx:if="{{!item.review.coachReply && item.review.status === 'approved'}}"
            bindtap="onReply" data-id="{{item.review.id}}">回复</button>
  </view>
  <view class="empty" wx:if="{{!items.length}}">暂无学员评价</view>
</view>
