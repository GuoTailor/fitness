<view class="page">
  <view class="q" wx:for="{{list}}" wx:key="id">
    <view class="q-head">
      <view class="q-pkg">{{item.packageTitle}}</view>
      <view class="q-status {{item.status}}">{{item.statusText}}</view>
    </view>
    <view class="q-content">{{item.content}}</view>
    <view class="q-meta">{{item.timeText}}</view>
    <view class="a" wx:for="{{item.answers}}" wx:for-item="a" wx:key="id">
      <text class="a-badge {{a.isCoach ? 'coach' : ''}}">{{a.isCoach ? '教练' : '学员'}}</text>
      <view class="a-body">
        <view class="a-content">{{a.content}}</view>
        <view class="a-meta">{{a.authorName || '学员'}} · {{a.timeText}}</view>
      </view>
    </view>
  </view>
  <view class="empty" wx:if="{{!list.length}}">还没有提问，去课包详情页提问吧</view>
</view>
