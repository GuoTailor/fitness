<view class="page">
  <view class="tabs">
    <view class="tab {{tab === 'hours' ? 'tab-active' : ''}}" bindtap="onTab" data-tab="hours">我的课时</view>
    <view class="tab {{tab === 'training' ? 'tab-active' : ''}}" bindtap="onTab" data-tab="training">
      训练跟踪<view class="badge" wx:if="{{pending.length}}">{{pending.length}}</view>
    </view>
  </view>

  <!-- 我的课时 -->
  <block wx:if="{{tab === 'hours'}}">
    <view class="pkg" wx:for="{{list}}" wx:key="id">
      <view class="pkg-main" bindtap="onPkg" data-id="{{item.id}}">
        <view class="pkg-head">
          <view class="pkg-title">{{item.packageTitle}}</view>
          <view class="pkg-status st-{{item.status}}">{{item.statusText}}</view>
        </view>
        <view class="nums">
          <view class="num">
            <view class="num-v">{{item.remaining}}</view>
            <view class="num-l">剩余课时</view>
          </view>
          <view class="num">
            <view class="num-v">{{item.usedSessions}}</view>
            <view class="num-l">已消耗</view>
          </view>
          <view class="num">
            <view class="num-v">{{item.totalSessions}}</view>
            <view class="num-l">总课时</view>
          </view>
          <view class="num">
            <view class="num-v num-s">{{item.expireText}}</view>
            <view class="num-l">有效期至</view>
          </view>
        </view>
        <view class="bar"><view class="bar-in" style="width: {{item.percent}}%"></view></view>
      </view>
      <view class="txns" wx:if="{{current === item.id}}">
        <view class="txn" wx:for="{{txns}}" wx:for-item="t" wx:key="id">
          <view class="txn-l">
            <view class="txn-type">{{t.type}}</view>
            <view class="txn-time">{{t.timeText}} {{t.remark}}</view>
          </view>
          <view class="txn-v {{t.sessionsChange > 0 ? 'pos' : 'neg'}}">{{t.sign}}{{t.sessionsChange}}</view>
        </view>
        <view class="txn-empty" wx:if="{{!txns.length}}">暂无流水</view>
      </view>
    </view>

    <view class="empty" wx:if="{{!list.length}}">
      <view>还没有课包</view>
      <button class="go-buy" size="mini" bindtap="goBuy">去逛逛</button>
    </view>
  </block>

  <!-- 训练跟踪 -->
  <block wx:if="{{tab === 'training'}}">
    <view class="stat-grid" wx:if="{{stats}}">
      <view class="stat">
        <view class="v">{{stats.week.lessons}}</view>
        <view class="l">本周上课</view>
      </view>
      <view class="stat">
        <view class="v">{{stats.week.minutes}}</view>
        <view class="l">本周分钟</view>
      </view>
      <view class="stat">
        <view class="v">{{stats.month.lessons}}</view>
        <view class="l">本月上课</view>
      </view>
      <view class="stat">
        <view class="v">{{stats.month.minutes}}</view>
        <view class="l">本月分钟</view>
      </view>
    </view>

    <!-- 打卡挑战：月度上课达标发券 -->
    <view class="pkg ck-card" wx:if="{{checkin.enabled}}">
      <view class="ck-head">
        <view class="sec-title">本月打卡挑战</view>
        <view class="ck-badge {{checkin.claimed ? 'done' : (checkin.claimable ? 'ready' : '')}}">
          {{checkin.claimed ? '已领取' : (checkin.claimable ? '可领取' : '进行中')}}
        </view>
      </view>
      <view class="ck-progress">
        <view class="ck-bar"><view class="ck-fill" style="width: {{checkin.percent}}%"></view></view>
        <view class="ck-num">{{checkin.count}}/{{checkin.target}} 次</view>
      </view>
      <view class="ck-sub">{{checkin.claimed ? '本月奖励已到账，次月再来' : (checkin.claimable ? '达标啦，领取本月奖励券' : '再上 ' + checkin.remaining + ' 次课即可领奖励券')}}</view>
      <button wx:if="{{checkin.claimable}}" class="ck-btn" size="mini" loading="{{claiming}}" bindtap="onClaimCheckin">领取奖励</button>
    </view>

    <view class="pkg">
      <view class="sec-title">训练日历（{{month}}）</view>
      <view class="week-row">
        <view class="wd" wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this">{{item}}</view>
      </view>
      <view class="cal">
        <view class="cell {{item.blank ? 'blank' : ''}}" wx:for="{{calendar}}" wx:key="index">
          <block wx:if="{{!item.blank}}">
            <view class="d {{item.today ? 'today' : ''}}">{{item.day}}</view>
            <view class="dot" wx:if="{{item.count}}"></view>
          </block>
        </view>
      </view>
    </view>

    <view class="report-entry" bindtap="goReport">
      <view class="re-l">
        <view class="re-t">训练周报</view>
        <view class="re-s">每周训练量、教练分布与体重变化</view>
      </view>
      <view class="re-go">查看 ›</view>
    </view>

    <view class="pkg">
      <view class="sec-title">体重记录 {{latestWeight ? '· 当前 ' + latestWeight + 'kg' : ''}}</view>
      <view class="w-input-row">
        <input class="w-input" type="digit" placeholder="记录今日体重（kg）" value="{{weightKg}}" bindinput="onWeightInput" />
        <button class="w-save" size="mini" bindtap="onSaveWeight">记录</button>
      </view>
      <view class="w-chart" wx:if="{{weightBars.length > 1}}">
        <view class="w-bar" wx:for="{{weightBars}}" wx:key="index" style="height: {{item.pct}}%"></view>
      </view>
      <view class="txn-empty" wx:if="{{weightCount < 2}}">记录两次以上体重后展示趋势曲线</view>
    </view>

    <view class="pkg" wx:if="{{feedbacks.length}}">
      <view class="sec-title">教练课后反馈</view>
      <view class="fb" wx:for="{{feedbacks}}" wx:key="index">
        <view class="fb-head">
          <text class="fb-coach">{{item.coachName}} 教练</text>
          <text class="fb-meta">{{item.typeText}} · {{item.dateText}}</text>
        </view>
        <view class="fb-content">{{item.feedback.content}}</view>
      </view>
    </view>

    <view class="pkg" wx:if="{{pending.length}}">
      <view class="sec-title">待评价（{{pending.length}}）</view>
      <view class="pend" wx:for="{{pending}}" wx:key="verificationId" bindtap="goReview">
        <view class="pend-l">
          <view class="pend-name">{{item.projectName}}</view>
          <view class="pend-sub">{{item.coachName}} · {{item.dateText}}</view>
        </view>
        <view class="pend-go">去评价 ›</view>
      </view>
    </view>

    <view class="pkg">
      <view class="sec-title">训练记录</view>
      <view class="rec" wx:for="{{records}}" wx:key="id">
        <view class="rec-l">
          <view class="rec-t">{{item.project}}</view>
          <view class="rec-s">{{item.recordDate}} · {{item.sourceText}}</view>
        </view>
        <view class="rec-r">{{item.durationMinutes}} 分钟</view>
      </view>
      <view class="txn-empty" wx:if="{{!records.length}}">完成上课后自动生成记录</view>
    </view>
  </block>
</view>
