<view class="page" wx:if="{{detail}}">
  <video wx:if="{{detail.package.introVideoUrl}}" class="video" src="{{detail.package.introVideoUrl}}" object-fit="cover" />
  <image wx:else class="video cover" src="{{detail.package.coverUrl}}" mode="aspectFill" />

  <view class="card">
    <view class="title">{{detail.package.title}}</view>
    <view class="meta">
      <text class="tag" wx:for="{{detail.package.tags ? detail.package.tags.split(',') : []}}" wx:key="*this">{{item}}</text>
      <text class="difficulty">难度 {{detail.package.difficulty}}/5</text>
      <text class="rating" wx:if="{{detail.ratingCount}}">★ {{detail.ratingAvg}}（{{detail.ratingCount}}条评价）</text>
    </view>
  </view>

  <view class="card">
    <view class="section-title">选择规格</view>
    <view class="sku-list">
      <view wx:for="{{detail.skus}}" wx:key="id"
        class="sku {{selectedSku === index ? 'sku-active' : ''}}"
        bindtap="onSku" data-index="{{index}}">
        <view class="sku-name">{{item.name}}</view>
        <view class="sku-sub">{{item.sessions}}节 · 有效期{{item.validDays}}天</view>
        <view class="sku-price">
          <block wx:if="{{item.dispYuan}}">
            <text class="np">¥{{item.dispYuan}}</text>
            <text class="strike">¥{{item.priceYuan}}</text>
            <text class="np-tag {{item.dispTag === '限时价' ? 'promo-tag' : ''}}">{{item.dispTag}}</text>
          </block>
          <text wx:else>¥{{item.priceYuan}}</text>
        </view>
      </view>
    </view>
    <view class="coupon-bar" wx:if="{{selectedSku >= 0}}" bindtap="onPickCoupon">
      <text class="c-label">优惠券</text>
      <text class="c-value">{{couponIndex >= 0 ? coupons[couponIndex].name + ' ' + coupons[couponIndex].label + '（-¥' + coupons[couponIndex].benefitYuan + '）' : (coupons.length ? '不使用优惠券' : '暂无可用券')}}</text>
      <text class="c-go" catchtap="onGoCouponCenter">领券</text>
      <text class="c-arrow">›</text>
    </view>
    <view class="promo-count" wx:if="{{selectedSku >= 0 && detail.skus[selectedSku].promoActive && promoLeft}}">
      限时活动 · 距结束 {{promoLeft}}
    </view>
    <view class="np-tip" wx:if="{{selectedSku >= 0 && (detail.skus[selectedSku].newcomerYuan || detail.skus[selectedSku].promoActive)}}">新人价/限时活动价与优惠券不叠加，自动按最优结算；赠课券可叠加（购课赠课时）</view>
    <!-- 拼团入口：SKU 配置了拼团价时展示（限时活动生效时服务端已覆盖价格/人数） -->
    <view class="gb-bar" wx:if="{{selectedSku >= 0 && detail.skus[selectedSku].groupPrice > 0}}">
      <view class="gb-info">
        <view class="gb-line">
          <text class="gb-price">{{detail.skus[selectedSku].groupCapacity}}人团 ¥{{detail.skus[selectedSku].groupPrice / 100}}</text>
          <text class="gb-act" wx:if="{{detail.skus[selectedSku].groupActivityTitle}}">限时 · {{detail.skus[selectedSku].groupActivityTitle}}</text>
        </view>
        <text class="gb-tip">拼团价不与券/新人价叠加，未成团自动退款</text>
      </view>
      <button class="gb-btn" size="mini" catchtap="onGoGroupBuy">去拼团</button>
    </view>
  </view>

  <view class="card">
    <view class="section-title">课程大纲</view>
    <view class="rich">{{detail.package.outline || '暂无介绍'}}</view>
    <view class="section-title" style="margin-top:24rpx">适合人群</view>
    <view class="rich">{{detail.package.suitable || '—'}}</view>
  </view>

  <view class="card">
    <view class="section-title">授课教练</view>
    <view class="coach-row" wx:for="{{detail.coaches}}" wx:key="id" bindtap="onCoach" data-id="{{item.id}}">
      <image class="coach-avatar" src="{{item.avatarUrl || '/assets/avatar-default.png'}}" mode="aspectFill" />
      <view class="coach-info">
        <view class="coach-name">{{item.name}} <text class="cert" wx:if="{{item.certVerified}}">已认证</text></view>
        <view class="coach-sub">{{item.specialties}} · {{item.years}}年教龄</view>
      </view>
    </view>
    <view class="empty-inline" wx:if="{{!detail.coaches.length}}">暂未关联教练</view>
  </view>

  <view class="card">
    <view class="tabs">
      <view class="tab {{reviewTab === 'reviews' ? 'tab-active' : ''}}" bindtap="onTab" data-tab="reviews">
        学员评价（{{detail.ratingCount}}）
      </view>
      <view class="tab {{reviewTab === 'qa' ? 'tab-active' : ''}}" bindtap="onTab" data-tab="qa">
        课程问答{{qaTotal ? '（' + qaTotal + '）' : ''}}
      </view>
    </view>

    <block wx:if="{{reviewTab === 'reviews'}}">
      <view wx:for="{{detail.reviews}}" wx:key="id" class="review">
        <view class="review-head">
          <text class="review-stars">{{item.rating}}★</text>
          <text class="review-time">{{item.createdAt}}</text>
        </view>
        <view class="review-content">{{item.content}}</view>
        <view class="review-reply" wx:if="{{item.coachReply}}">教练回复：{{item.coachReply}}</view>
      </view>
      <view class="empty-inline" wx:if="{{!detail.reviews.length}}">暂无评价，完成上课后即可评价</view>
      <navigator class="all-reviews" wx:if="{{detail.ratingCount > 5}}"
                 url="/pages/review/public?type=package&id={{detail.package.id}}">查看全部 {{detail.ratingCount}} 条评价 ›</navigator>
    </block>

    <block wx:if="{{reviewTab === 'qa'}}">
      <view class="qa-ask-bar" bindtap="onToggleAsk">
        <text class="qa-ask-tip">想了解这门课？提问前先看看已有问答</text>
        <text class="qa-ask-btn">提问 ›</text>
      </view>
      <view class="qa-form" wx:if="{{askOpen}}">
        <textarea class="qa-ta" value="{{askContent}}" maxlength="500" placeholder="例如：零基础可以上吗？需要准备什么？" bindinput="onAskInput"></textarea>
        <view class="qa-form-foot">
          <view class="qa-anon">
            <text>匿名展示</text>
            <switch checked="{{askAnonymous}}" bindchange="onAskAnon" color="#00B578" />
          </view>
          <button class="qa-submit" size="mini" disabled="{{asking}}" bindtap="onSubmitAsk">{{asking ? '提交中…' : '提交提问'}}</button>
        </view>
      </view>

      <view class="qa-item" wx:for="{{qaList}}" wx:key="id">
        <view class="qa-q">
          <text class="qa-badge q">问</text>
          <view class="qa-q-body">
            <view class="qa-q-content">{{item.content}}</view>
            <view class="qa-meta">{{item.asker}} · {{item.timeText}}</view>
          </view>
          <text class="qa-pin" wx:if="{{item.pinned}}">置顶</text>
        </view>
        <view class="qa-a" wx:for="{{item.answers}}" wx:for-item="a" wx:key="id">
          <text class="qa-badge a {{a.isCoach ? 'coach' : ''}}">{{a.isCoach ? '教练' : '答'}}</text>
          <view class="qa-a-body">
            <view class="qa-a-content">{{a.content}}</view>
            <view class="qa-meta">{{a.authorName || '学员'}} · {{a.timeText}}</view>
          </view>
        </view>
        <view class="qa-none" wx:if="{{!item.answers.length}}">等待教练或已购学员回复</view>
      </view>
      <view class="empty-inline" wx:if="{{!qaList.length && !asking}}">暂无提问，来问第一个问题吧</view>
    </block>
  </view>

  <view class="footer-bar-space"></view>
  <view class="footer-bar">
    <view class="pay-amount" wx:if="{{payYuan}}">
      <text class="pa-label">预估合计</text>
      <text class="pa-num">¥{{payYuan}}</text>
    </view>
    <button class="buy-btn {{selectedSku < 0 ? 'disabled' : ''}}" disabled="{{buying}}" bindtap="onBuy">
      {{buying ? '处理中…' : (selectedSku < 0 ? '请选择规格' : '立即购买')}}
    </button>
  </view>
</view>
