.page {
  padding: 24rpx;
}

.profile {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #f0f0f0;
  margin-right: 24rpx;
}

.nickname {
  font-size: 32rpx;
  font-weight: 600;
}

.sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 12rpx 24rpx;
  margin-bottom: 24rpx;
}

.login-card {
  padding: 48rpx 32rpx;
  text-align: center;
}

.login-tip {
  color: #666;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.btn-primary {
  background: #00b578;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.menu-item {
  padding: 28rpx 8rpx;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f2f3f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-btn {
  text-align: left;
  padding: 28rpx 8rpx;
  font-size: 28rpx;
  background: transparent;
  border-radius: 0;
  border-bottom: 1rpx solid #f2f3f5;
  line-height: 1.4;
}

.menu-btn::after {
  border: none;
}

.logout {
  color: #e64340;
}

.coach-entry {
  color: #4a90ff;
  font-weight: 600;
}

.coupon-entry {
  color: #e64340;
  font-weight: 600;
}

.links {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 0 40rpx;
  font-size: 24rpx;
  color: #999;
}

.dot {
  color: #ddd;
}
