.page { padding: 24rpx; }
.day-strip { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 20rpx; }
.d { background: #fff; border-radius: 10rpx; padding: 10rpx 20rpx; font-size: 24rpx; color: #555; }
.d-active { background: #00b578; color: #fff; }
.gc { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; display: flex; justify-content: space-between; align-items: center; }
.gc-time { font-size: 34rpx; font-weight: 700; color: #00b578; }
.gc-title { font-size: 28rpx; margin-top: 6rpx; }
.gc-sub { font-size: 22rpx; color: #999; margin-top: 6rpx; }
.gc-actions { display: flex; flex-direction: column; gap: 10rpx; }
.a { border: 2rpx solid #ddd; color: #666; border-radius: 26rpx; }
.a-main { border-color: #00b578; color: #00b578; background: #f0faf6; }
.empty { text-align: center; color: #999; padding: 80rpx 0; }

/* 候补按钮 */
.a.wl { background: #fff7e6; color: #d48806; border: 1rpx solid #ffd666; }
.a.wl-on { background: #f0f9eb; color: #67c23a; border: 1rpx solid #b3e19d; }
