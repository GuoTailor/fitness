.page { padding: 24rpx; }
.sec-title { font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; }
.st-row { display: flex; align-items: center; gap: 16rpx; }
.st { font-size: 26rpx; padding: 6rpx 20rpx; border-radius: 999rpx; background: #fff7e6; color: #d48806; }
.st-ok { background: #e6f7ef; color: #00B578; }
.st-bad { background: #fdecea; color: #e64340; }
.st-time { font-size: 22rpx; color: #999; }
.reason { margin-top: 16rpx; font-size: 24rpx; color: #e64340; }
.tip { margin-top: 16rpx; font-size: 22rpx; color: #999; }
.form-row { display: flex; align-items: center; gap: 20rpx; margin-bottom: 22rpx; }
.form-row.col { flex-direction: column; align-items: stretch; }
.label { font-size: 26rpx; color: #666; width: 140rpx; flex-shrink: 0; }
.form-row.col .label { width: auto; }
.input { flex: 1; background: #f5f6f8; border-radius: 10rpx; padding: 16rpx 20rpx; font-size: 28rpx; }
.gender { display: flex; gap: 14rpx; }
.g { font-size: 26rpx; padding: 10rpx 34rpx; border-radius: 999rpx; background: #f5f6f8; color: #666; }
.g-on { background: #00B578; color: #fff; }
.certs { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 14rpx; }
.cert { position: relative; width: 150rpx; height: 150rpx; border-radius: 12rpx; overflow: hidden; }
.cert image { width: 100%; height: 100%; }
.cert.add { display: flex; align-items: center; justify-content: center; background: #f5f6f8; color: #999; font-size: 24rpx; }
.del { position: absolute; top: 0; right: 0; width: 40rpx; height: 40rpx; background: rgba(0,0,0,0.5); color: #fff; font-size: 28rpx; text-align: center; line-height: 40rpx; }
.ta { width: 100%; box-sizing: border-box; background: #f5f6f8; border-radius: 10rpx; padding: 16rpx 20rpx; font-size: 26rpx; min-height: 140rpx; }
.submit { margin-top: 10rpx; background: #00B578; color: #fff; }
.submit::after { border: none; }
