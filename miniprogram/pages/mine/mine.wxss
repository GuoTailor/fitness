.page {
  padding: 24rpx;
}

.profile {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #f0f0f0;
  margin-right: 24rpx;
}

.nickname {
  font-size: 32rpx;
  font-weight: 600;
}

.sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 12rpx 24rpx;
  margin-bottom: 24rpx;
}

.login-card {
  padding: 48rpx 32rpx;
  text-align: center;
}

.login-tip {
  color: #666;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.btn-primary {
  background: #00b578;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.menu-item {
  padding: 28rpx 8rpx;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f2f3f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-btn {
  text-align: left;
  padding: 28rpx 8rpx;
  font-size: 28rpx;
  background: transparent;
  border-radius: 0;
  border-bottom: 1rpx solid #f2f3f5;
  line-height: 1.4;
}

.menu-btn::after {
  border: none;
}

.logout {
  color: #e64340;
}

.coach-entry {
  color: #4a90ff;
  font-weight: 600;
}

.coupon-entry {
  color: #e64340;
  font-weight: 600;
}

.links {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 0 40rpx;
  font-size: 24rpx;
  color: #999;
}

.dot {
  color: #ddd;
}

/* 资料编辑 */
.edit-entry { flex-shrink: 0; color: #999; font-size: 24rpx; align-self: center; }
.edit-card { margin-bottom: 24rpx; }
.edit-title { font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; }
.edit-row { display: flex; align-items: center; gap: 20rpx; margin-bottom: 20rpx; }
.avatar-btn { padding: 0; background: transparent; line-height: 1.4; display: flex; flex-direction: column; align-items: center; }
.avatar-btn::after { border: none; }
.avatar-edit { width: 120rpx; height: 120rpx; border-radius: 50%; }
.avatar-tip { font-size: 20rpx; color: #999; margin-top: 8rpx; }
.edit-label { font-size: 28rpx; color: #666; width: 100rpx; }
.edit-input { flex: 1; background: #f5f6f8; border-radius: 10rpx; padding: 14rpx 20rpx; font-size: 28rpx; }
.edit-btns { display: flex; justify-content: flex-end; gap: 16rpx; }
.edit-save { background: #00B578; color: #fff; }

/* 邀请好友 */
.ref-card { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.ref-title { font-size: 30rpx; font-weight: 600; }
.ref-sub { font-size: 22rpx; color: #999; margin-top: 6rpx; }
.ref-share { background: #00B578; color: #fff; font-size: 24rpx; padding: 0 24rpx; line-height: 56rpx; }
.ref-share::after { border: none; }
