.card { background: #fff; border-radius: 16rpx; margin: 20rpx 24rpx; padding: 28rpx 24rpx; }

.head { display: flex; justify-content: space-between; }

.nick { font-size: 26rpx; font-weight: 500; }

.status { font-size: 22rpx; color: #999; }

.st-pending { color: #ff9c00; }

.st-approved { color: #00b578; }

.row { display: flex; justify-content: space-between; align-items: center; margin-top: 8rpx; }

.star { font-size: 26rpx; color: #ddd; }

.star.on { color: #ffb400; }

.time { font-size: 22rpx; color: #bbb; }

.content { font-size: 26rpx; color: #333; margin-top: 12rpx; line-height: 1.6; }

.reply { font-size: 24rpx; color: #555; background: #f0faf6; border-radius: 10rpx; padding: 14rpx; margin-top: 12rpx; }

.reply-tag { color: #00b578; font-size: 22rpx; margin-bottom: 6rpx; }

.reply-btn { margin-top: 16rpx; background: #00b578; color: #fff; border-radius: 30rpx; }

.empty { text-align: center; color: #999; font-size: 26rpx; padding: 120rpx 0; }

.imgs { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.r-img { width: 160rpx; height: 160rpx; border-radius: 10rpx; background: #f0f0f0; }
