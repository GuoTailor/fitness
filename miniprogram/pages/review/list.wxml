<view class="page">
  <view class="card" wx:for="{{items}}" wx:key="index">
    <view class="head">
      <view class="type">{{item.typeText}}</view>
      <view class="status st-{{item.review.status}}">{{item.statusText}}</view>
    </view>
    <view class="stars">
      <text wx:for="{{item.starsArr}}" wx:for-item="s" wx:key="*this" class="star {{s ? 'on' : ''}}">★</text>
    </view>
    <view class="content" wx:if="{{item.review.content}}">{{item.review.content}}</view>
    <view class="reply" wx:if="{{item.review.coachReply}}">教练回复：{{item.review.coachReply}}</view>
    <view class="time">{{item.timeText}}</view>
  </view>
  <view class="empty" wx:if="{{!items.length}}">
    <view>还没有评价</view>
    <navigator class="go" url="/pages/review/create">去评价完成的课程 ›</navigator>
  </view>
</view>
