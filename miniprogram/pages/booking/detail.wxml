<view class="page">
  <view class="card">
    <view class="title">{{title}} · 核销码</view>
    <view class="time">{{timeText}}</view>
    <view class="code-box" wx:if="{{code}}">
      <view class="code">{{code}}</view>
      <view class="tip">到店向教练出示此码（或让教练输入）完成上课</view>
      <button class="copy-btn" size="mini" bindtap="onCopy">复制核销码</button>
    </view>
    <view class="tip" wx:else>当前状态（{{status}}）无需核销</view>
  </view>

  <view class="card" wx:if="{{canReview}}">
    <view class="review-tip">这节课已完成，说说你的上课体验吧</view>
    <button class="review-btn" bindtap="goReview">去评价</button>
  </view>
</view>
