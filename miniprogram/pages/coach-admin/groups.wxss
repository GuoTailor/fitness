.page { padding: 24rpx; }
.pub-btn { background: #001529; color: #fff; border-radius: 14rpx; margin-bottom: 20rpx; }
.gc { background: #fff; border-radius: 14rpx; padding: 24rpx; margin-bottom: 16rpx; display: flex; justify-content: space-between; align-items: center; }
.gc-title { font-size: 28rpx; font-weight: 600; }
.gc-sub { font-size: 22rpx; color: #999; margin-top: 8rpx; }
.gc-ops { display: flex; flex-direction: column; gap: 12rpx; }
.op { color: #4a90ff; font-size: 24rpx; }
.op-danger { color: #e64340; }
.empty { text-align: center; color: #999; padding: 80rpx 0; }
.mask { position: fixed; inset: 0; background: rgba(0,0,0,.4); display: flex; align-items: flex-end; z-index: 9; }
.form { width: 100%; background: #fff; border-radius: 24rpx 24rpx 0 0; padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.f-title { font-size: 32rpx; font-weight: 600; margin-bottom: 24rpx; text-align: center; }
.f-row { background: #f6f7f9; border-radius: 10rpx; padding: 18rpx 20rpx; font-size: 26rpx; margin-bottom: 16rpx; }
.f-row-2 { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.f-row-2 picker { flex: 1; }
.f-input { background: #f6f7f9; border-radius: 10rpx; padding: 18rpx 20rpx; font-size: 26rpx; margin-bottom: 16rpx; }
.f-submit { background: #00b578; color: #fff; border-radius: 40rpx; margin-top: 8rpx; }
